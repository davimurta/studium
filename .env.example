# Postgres (Railway: use a URL interna do banco em producao, ex.: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studium"

# Segredo do Auth.js. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# "true" permite criar conta em /cadastro. Use "false" em producao depois de criar a sua.
ALLOW_SIGNUP="true"
