generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  NOT_STARTED
  STUDYING
  DONE
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String
  createdAt     DateTime       @default(now())
  topics        Topic[]
  roadmaps      Roadmap[]
  studyLogs     StudyLog[]
  languages     Language[]
  routineItems  RoutineItem[]
  routineChecks RoutineCheck[]
  languagePlan  LanguagePlan?
}

model Topic {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       Status        @default(NOT_STARTED)
  tags         String[]
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  note         Note?
  resources    Resource[]
  studyLogs    StudyLog[]
  roadmapItems RoadmapItem[]
  language     Language?

  @@index([userId, status])
}

model Note {
  id        String   @id @default(cuid())
  topicId   String   @unique
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

model Resource {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  url       String
  createdAt DateTime @default(now())
}

model Roadmap {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       RoadmapItem[]

  @@index([userId])
}

model RoadmapItem {
  id        String        @id @default(cuid())
  roadmapId String
  roadmap   Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  // Subetapa aponta para a etapa principal (um nivel so). Etapa principal tem parentId nulo.
  parentId  String?
  parent    RoadmapItem?  @relation("ItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  RoadmapItem[] @relation("ItemChildren")
  topicId   String?
  topic     Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title     String
  // Posicao entre irmaos (mesmo parentId).
  position  Int
  status    Status        @default(NOT_STARTED)

  @@index([roadmapId, position])
  @@index([parentId, position])
}

model StudyLog {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  minutes      Int
  date         DateTime      @db.Date
  createdAt    DateTime      @default(now())
  routineCheck RoutineCheck?

  @@index([userId, date])
}

/**
 * Linguas: rotina diaria repetida, revisoes semanais e mensais.
 */

enum LanguageStatus {
  ACTIVE
  MAINTENANCE
  PLANNED
  NATIVE
}

enum RoutineFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Language {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  level       String         @default("")
  goal        String         @default("")
  status      LanguageStatus @default(PLANNED)
  // Horas estimadas ate a proxima meta (referencia para a barra de horas).
  targetHours Int?
  position    Int
  // Topico onde ficam notas, recursos e as sessoes de estudo da lingua.
  topicId     String?        @unique
  topic       Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  routine     RoutineItem[]

  @@index([userId, position])
}

model RoutineItem {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId String?
  language   Language?        @relation(fields: [languageId], references: [id], onDelete: SetNull)
  title      String
  details    String?
  frequency  RoutineFrequency @default(DAILY)
  // Dias da semana (0 = domingo ... 6 = sabado). Vazio = todos os dias. So vale para DAILY.
  weekdays   Int[]
  minutes    Int              @default(0)
  position   Int
  archivedAt DateTime?
  createdAt  DateTime         @default(now())
  checks     RoutineCheck[]

  @@index([userId, frequency, position])
}

model RoutineCheck {
  id         String      @id @default(cuid())
  itemId     String
  item       RoutineItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Dia (DAILY), segunda-feira da semana (WEEKLY) ou dia 1 do mes (MONTHLY).
  period     DateTime    @db.Date
  minutes    Int         @default(0)
  // Sessao de estudo criada ao marcar o item (some junto ao desmarcar).
  studyLogId String?     @unique
  studyLog   StudyLog?   @relation(fields: [studyLogId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@unique([itemId, period])
  @@index([userId, period])
}

model LanguagePlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @default("")
  updatedAt DateTime @updatedAt
}
